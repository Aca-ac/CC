{
  "name": "@chronos/client",
  "version": "0.1.0",
  "private": true,
  "description": "Chronos Electron + React + Vite 前端脚手架。",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.app.json && vite build && tsc -p electron/tsconfig.json",
    "electron:start": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "electron:dev": "concurrently \"npm:dev\" \"npm:electron:start\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^42.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
