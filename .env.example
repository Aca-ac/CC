# Chronos 本地开发环境变量模板
# 复制为 .env 或对应模块内的 .env.local 后再填写真实值。

# 前端调用后端 API 的基础地址。开发环境默认由 Vite 代理到本地后端。
VITE_API_BASE_URL=http://localhost:8080/api

# 后端服务端口。
SERVER_PORT=8080

# MySQL 云端数据库连接。脚手架阶段先不强制启用，后续联调时再填写。
CHRONOS_MYSQL_URL=jdbc:mysql://localhost:3306/chronos?useSSL=false&serverTimezone=Asia/Shanghai
CHRONOS_MYSQL_USERNAME=chronos
CHRONOS_MYSQL_PASSWORD=chronos_password

# JWT 签名密钥。课程演示环境也不要提交真实密钥到 Git。
CHRONOS_JWT_SECRET=replace-with-a-long-random-secret

# AI 服务配置。当前框架只保留接口形态，不会真实调用第三方 LLM。
CHRONOS_AI_PROVIDER=mock
CHRONOS_AI_API_KEY=

